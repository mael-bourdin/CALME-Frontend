{
  "name": "calme-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "description": "Interface de la cabine C.A.L.M.E. — Workshop Horizon 2080, EPSI B3 groupe 10",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
