# Racine de l'API du serveur de bord.
# En développement, laisser vide : le proxy Vite renvoie /api vers VITE_DEV_API_TARGET
# et on évite CORS. En production, le serveur de bord sert le front lui-même,
# donc le chemin relatif fonctionne aussi.
VITE_API_BASE_URL=/api/v1

# Racine du WebSocket. Déduite de l'API si absente.
# VITE_WS_BASE_URL=ws://calme.local/api/v1

# Cible du proxy de développement : là où tourne le FastAPI.
VITE_DEV_API_TARGET=http://localhost:8000

# Mettre à false pour parler au vrai serveur. Toute autre valeur garde le
# transport simulé, qui implémente exactement la même interface.
VITE_USE_MOCK=true

# Accélère la minute de mesure simulée. Sans effet sur le vrai serveur.
VITE_MOCK_SPEED=4

# Identifiant de la cabine, pour les déploiements à plusieurs cabines.
VITE_CABIN_ID=cabine-01
